{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-stack-skills.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dev-env-reminder.sh\"",
            "statusMessage": "Checking repo against your dev-env standard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-on-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Linting changed file..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/latest-deps-reminder.sh\"",
            "statusMessage": "Checking dependency versions are current..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dockerfile-reminder.sh\"",
            "statusMessage": "Checking Dockerfile layer ordering..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-plaintext-reminder.sh\"",
            "statusMessage": "Checking for plaintext secrets..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/popover-reminder.sh\"",
            "statusMessage": "Checking popover/tooltip positioning..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ci-action-ref-reminder.sh\"",
            "statusMessage": "Checking GitHub Actions refs resolve..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/plan-reminder.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/verify-work.sh\"",
            "timeout": 120,
            "statusMessage": "Verifying tests and linters..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/debug-leftover-reminder.sh\"",
            "statusMessage": "Checking for leftover debug statements..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/missing-test-reminder.sh\"",
            "statusMessage": "Checking new source files have tests..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/review-reminder.sh\"",
            "statusMessage": "Checking whether a code review ran this session..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/memory-reminder.sh\"",
            "statusMessage": "Checking for session learnings worth remembering..."
          }
        ]
      }
    ]
  }
}
