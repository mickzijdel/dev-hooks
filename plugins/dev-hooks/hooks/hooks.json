{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/detect-stack-skills.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dev-env-reminder.sh\"",
            "statusMessage": "Checking repo against your dev-env standard..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/docs-context.sh\"",
            "statusMessage": "Indexing project documentation..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/script-index.sh\"",
            "statusMessage": "Indexing your saved CLI script library..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt-log.sh\"",
            "statusMessage": "Logging prompt for the weekly automation review..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/intent-check-reminder.sh\"",
            "statusMessage": "Checking the task brief states a goal and non-goals..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dangerous-command-guard.sh\"",
            "statusMessage": "Checking command safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ci-watch-reminder.sh\"",
            "statusMessage": "Checking whether a push should watch CI..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/worktree-provision-reminder.sh\"",
            "statusMessage": "Checking the new worktree has its gitignored state..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-on-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Linting changed file..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/latest-deps-reminder.sh\"",
            "statusMessage": "Checking dependency versions are current..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scaffold-reminder.sh\"",
            "statusMessage": "Checking for hand-rolled project scaffolding..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/dockerfile-reminder.sh\"",
            "statusMessage": "Checking Dockerfile layer ordering..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-plaintext-reminder.sh\"",
            "statusMessage": "Checking for plaintext secrets..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/popover-reminder.sh\"",
            "statusMessage": "Checking popover/tooltip positioning..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ci-action-ref-reminder.sh\"",
            "statusMessage": "Checking GitHub Actions refs resolve..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inline-svg-reminder.sh\"",
            "timeout": 30,
            "statusMessage": "Checking for inline SVG markup..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/migration-safety-reminder.sh\"",
            "statusMessage": "Checking database migration safety..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/a11y-reminder.sh\"",
            "statusMessage": "Checking frontend accessibility..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/sql-injection-reminder.sh\"",
            "statusMessage": "Checking for string-interpolated SQL..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/error-swallow-reminder.sh\"",
            "statusMessage": "Checking for swallowed exceptions..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/plan-reminder.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/verify-work.sh\"",
            "timeout": 120,
            "statusMessage": "Verifying tests and linters..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/debug-leftover-reminder.sh\"",
            "statusMessage": "Checking for leftover debug statements..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/todo-leftover-reminder.sh\"",
            "statusMessage": "Checking for leftover TODO/FIXME markers..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/missing-test-reminder.sh\"",
            "statusMessage": "Checking new source files have tests..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/review-reminder.sh\"",
            "statusMessage": "Checking whether a code review ran this session..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/compress-comments-reminder.sh\"",
            "statusMessage": "Checking for verbose comments added this session..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/memory-reminder.sh\"",
            "statusMessage": "Checking for session learnings worth remembering..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/big-change-reminder.sh\"",
            "statusMessage": "Checking the size of this session's change..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/change-summary-reminder.sh\"",
            "statusMessage": "Checking for a per-file change summary..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/save-script-reminder.sh\"",
            "statusMessage": "Checking for reusable one-off scripts to save..."
          }
        ]
      }
    ]
  }
}
