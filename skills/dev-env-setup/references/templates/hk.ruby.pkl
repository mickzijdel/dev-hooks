// dev-env standard (dev-hooks:dev-env-setup) — version tracked via DEV_ENV_VERSION in mise.toml.
amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["rubocop"] {
        glob = "**/*.rb"
        check = "bin/rubocop"
        fix = "bin/rubocop -A"
    }
    ["test"] {
        glob = "**/*.rb"
        check = "bin/rails test"
    }
    // Secret scanning (defense-in-depth alongside fnox). hk builtin.
    ["gitleaks"] = Builtins.gitleaks
    // Block accidentally-committed large files. hk builtin.
    ["check-added-large-files"] = Builtins.check_added_large_files
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    // `check` adds the noisier audits on top of the linters — they run here (and in CI) but NOT
    // on pre-commit. Duplication uses two complementary tools: flay (Ruby AST/structural,
    // advisory — exits 0, surfaces renamed clones) and jscpd (token-based, polyglot — the
    // enforcing gate that also covers JS/CSS/SCSS/ERB). Add `flay` and `debride` to the Gemfile
    // dev group; jscpd runs via npx (needs `node`, see mise.toml) and reads `.jscpd.json`.
    ["check"] {
        steps = (linters) {
            ["debride"] {
                glob = "**/*.rb"
                check = "bundle exec debride ."
            }
            ["flay"] {
                glob = "**/*.rb"
                check = "bundle exec flay ."
            }
            // `-f` scopes to code formats (no config equivalent) so docs/configs aren't flagged;
            // `.jscpd.json` `ignorePattern` excludes generated db/schema.rb etc. (See SKILL.md › jscpd note.)
            ["jscpd"] {
                glob = List("**/*.rb", "**/*.erb", "**/*.js", "**/*.css", "**/*.scss")
                check = "npx --yes jscpd@latest . -f ruby,erb,javascript,typescript,css,scss,sass,vue"
            }
        }
    }
}
