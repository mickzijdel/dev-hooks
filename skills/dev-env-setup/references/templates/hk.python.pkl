// dev-env standard (dev-hooks:dev-env-setup) — version tracked via DEV_ENV_VERSION in mise.toml.
amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["ruff-check"] {
        glob = "**/*.py"
        check = "uv run ruff check --force-exclude {{ files }}"
        fix = "uv run ruff check --force-exclude --fix {{ files }}"
    }
    ["ruff-format"] {
        glob = "**/*.py"
        check = "uv run ruff format --force-exclude --diff {{ files }}"
        fix = "uv run ruff format --force-exclude {{ files }}"
    }
    ["pytest"] {
        glob = "**/*.py"
        check = "uv run pytest"
    }
    // Secret scanning (defense-in-depth alongside fnox). hk builtin.
    ["gitleaks"] = Builtins.gitleaks
    // Block accidentally-committed large files. hk builtin.
    ["check-added-large-files"] = Builtins.check_added_large_files
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    // `check` adds the noisier audits (dead-code, duplication) on top of the linters.
    // They run here (and in CI) but NOT on pre-commit, to keep commits friction-free.
    ["check"] {
        steps = (linters) {
            // Scans `.` (all *.py, excluding .venv/build) plus any extensionless tracked file
            // with a python/uv shebang (PEP 723 CLIs like bin/foo).
            ["vulture"] {
                glob = "**/*.py"
                check = "uv run vulture --min-confidence 80 --exclude '*/.venv/*,.venv,build,dist' . $(git ls-files ':!*.py' | xargs -r grep -lE '^#!.*(python|uv run)' 2>/dev/null)"
            }
            // Duplication. jscpd 5.x via npx (the npm `cpd` binary needs platform packages
            // that npx resolves but the mise npm backend does not). Config in `.jscpd.json`
            // (ai + threshold reporters; threshold 0 = fail on any clone).
            ["jscpd"] {
                glob = "**/*.py"
                check = "npx --yes jscpd@latest ."
            }
        }
    }
}
