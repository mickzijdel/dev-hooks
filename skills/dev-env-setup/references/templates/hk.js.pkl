// dev-env standard (dev-hooks:dev-env-setup) — version tracked via DEV_ENV_VERSION in mise.toml.
// For JS/TypeScript repos.
amends "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.47.0/hk@1.47.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["prettier"] {
        glob = List("**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx", "**/*.astro", "**/*.css", "**/*.scss", "**/*.mdx", "**/*.json")
        check = "npx prettier --check {{ files }}"
        fix = "npx prettier --write {{ files }}"
    }
    // --- Audits (duplication) ---------------------------------------------------
    // jscpd 5.x via npx; config in `.jscpd.json`. `-f` scopes to code formats
    // (no config equivalent) so docs/yaml aren't flagged. (See dev-env-setup SKILL.md.)
    // The version-cooldown policy (latest on a 4-day cooldown, floored at v5) and the
    // offline fallback live in scripts/run-jscpd.sh, shared with the CI audit job so the
    // local and CI gates can't drift.
    ["jscpd"] {
        glob = List("**/*.js", "**/*.ts", "**/*.jsx", "**/*.tsx", "**/*.css", "**/*.scss")
        check = "bash scripts/run-jscpd.sh javascript,typescript,css,scss"
    }
    // Secret scanning (defense-in-depth alongside fnox). hk builtin.
    ["gitleaks"] = Builtins.gitleaks
    // Block accidentally-committed large files. hk builtin.
    ["check-added-large-files"] = Builtins.check_added_large_files
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    // `check` is the full suite CI runs. The audits (jscpd) already run on pre-commit;
    // `check` is just the same set under one name.
    ["check"] {
        steps = linters
    }
}
